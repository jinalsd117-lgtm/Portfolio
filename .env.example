# Public URL of the deployed site (no trailing slash). Used for canonical URLs,
# Open Graph, sitemap.xml, robots.txt and structured data.
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Contact form delivery. Leave empty to keep the form visibly disabled.
# Any HTTPS endpoint that accepts a JSON POST works: Formspree, Make, Zapier,
# n8n, a Slack workflow webhook, or your own API.
CONTACT_WEBHOOK_URL=

# Optional shared secret sent as the X-Webhook-Secret header.
CONTACT_WEBHOOK_SECRET=
